norm.t.compute <- function(ybar) {
theta <- seq(60, 180, length=500)
like <- dnorm(theta, mean=ybar, sd=sigma/sqrt(n))
prior <- dt((theta - mu)/tscale, 2)
post <- prior*like
post <- post/sum(post)
m <- sum(theta*psot)
s <- sqrt(sum(theta^2*post)-m^2)
c(ybar, m, s)
}
summ2 <- t(sapply(c(110, 120, 140), norm.t.compute))
summ2
