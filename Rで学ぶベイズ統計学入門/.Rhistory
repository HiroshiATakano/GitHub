alpha <- 16; beta <- 15174
yobs <- 1; ex <- 66
y <- 0:10
lam <- alpha/beta
py <- dpois(y, lam*ex) * dgamma(lam, spape = alpha, rate = beta)/
+ gamma(lam, spape = alpha + y, rate = beta + ex)
py <- dpois(y, lam*ex) * dgamma(lam, spape = alpha, rate = beta)/
+ gamma(lam, sape = alpha + y, rate = beta + ex)
py <- dpois(y, lam*ex) * dgamma(lam, sape = alpha, rate = beta)/
+ gamma(lam, sape = alpha + y, rate = beta + ex)
py <- dpois(y, lam*ex) * dgamma(lam, shape = alpha, rate = beta)/
+ gamma(lam, shape = alpha + y, rate = beta + ex)
py <- dpois(y, lam*ex) * dgamma(lam, shape = alpha, rate = beta)/
+ dgamma(lam, shape = alpha + y, rate = beta + ex)
cbind(y, round(py,3))
dpois(y, lam*ex)
dgamma(lam, shape = alpha, rate = beta)
dgamma(lam, shape = alpha + y, rate = beta + ex)
